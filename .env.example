# Copy to .env and fill in what you need. Every key here is optional.
# The app auto-detects a provider: GROQ -> OPENAI -> Ollama.

# --- LLM providers -------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Force a provider instead of auto-detecting: groq | openai | ollama
LLM_PROVIDER=

# --- Embeddings ----------------------------------------------------------
# all-MiniLM-L6-v2 is 384-dim and English-tuned. If you change this model,
# you must change EMBED_DIM to match the pgvector column width.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# --- Postgres -------------------------------------------------------------
# In Docker, use the service name `db` instead of `localhost`.
# Locally: postgresql://notebooklm:notebooklm@localhost:5432/notebooklm
DATABASE_URL=postgresql://notebooklm:notebooklm@localhost:5432/notebooklm
POSTGRES_USER=notebooklm
POSTGRES_PASSWORD=notebooklm
POSTGRES_DB=notebooklm
POSTGRES_PORT=5432
APP_PORT=8000
DB_POOL_MAX=8

# Where uploaded files are written. Defaults to ./data/uploads.
UPLOAD_DIR=

# Upload ceiling in megabytes. A larger file is rejected with HTTP 413 and the
# partial file is deleted. Defaults to 100.
MAX_UPLOAD_MB=100

# --- OCR for scanned documents --------------------------------------------
# OCR of scanned/image-only PDFs is on by default; PyMuPDF embeds Tesseract, so
# no external binary is needed - only the language data below. If it is missing,
# a scanned upload is refused with the command to install it rather than
# indexing nothing. The Docker image already has it.
#
# Fetch the language data with:  python -m app.ocr --install
# Check it with:                 python -m app.ocr --status
OCR_ENABLED=1

# Folder holding <lang>.traineddata. Defaults to ./data/tessdata.
TESSDATA_DIR=

# Tesseract language codes, space or plus separated. "eng" fits most documents;
# add "deu" or "fra" and install them to read those.
OCR_LANGUAGES=eng

# Resolution pages are rasterised at before recognition. 300 is the usual
# accuracy/cost sweet spot for printed text; higher mostly costs time.
OCR_DPI=300

# Pages per document OCR will touch, roughly a second per page. A document with
# more image pages than this is refused rather than indexed partially, so a
# half-read scan never looks like a complete one.
OCR_MAX_PAGES=50

# --- Dev server binding (run.py only) -----------------------------------
# Loopback by default. Set HOST=0.0.0.0 only to reach it from another machine;
# there is no auth, so that also exposes every session on the network.
HOST=127.0.0.1
PORT=8000

# --- Chunking & retrieval ------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6
MAX_CONTEXT_CHARS=14000

# Minimum cosine score for a chunk to count as relevant. Below this the app
# refuses to answer instead of guessing. Measured on MiniLM: relevant chunks
# score ~0.30-0.45, irrelevant ones ~0.05-0.15. Raising this too high makes
# the app refuse correct answers.
MIN_SCORE=0.25

# Max chunks retrieved from any single source, so answers can span sources.
# Set to TOP_K to disable diversity.
MAX_PER_SOURCE=3

# Prior conversation turns read from the session (0 disables follow-ups).
HISTORY_TURNS=6

# --- Web sources ----------------------------------------------------------
# The one feature that changes the privacy story. With this on, the search term
# is sent to the provider's search tool and this machine fetches the pages it
# finds; fetched pages are then indexed locally like any upload, so they stay
# citable and deletable. Set to 0 to keep every request on this machine.
WEB_SEARCH=1

# Groq model asked to find URLs. It is only asked for a list of links - never a
# summary - so a web page becomes a citable source rather than an uncitable
# paragraph of model prose. A search costs real tokens and real time (measured:
# 8-13s and 20k-40k prompt tokens on this model).
WEB_SEARCH_MODEL=openai/gpt-oss-20b

# Ceiling on pages fetched per search, and the guardrails on each fetch.
WEB_SEARCH_MAX_PAGES=5
WEB_FETCH_TIMEOUT=20
WEB_FETCH_MAX_MB=8
WEB_FETCH_MAX_REDIRECTS=3

# --- Tracing (off by default) ---------------------------------------------
# Tracing a RAG system sends retrieved passages to a third party, and those
# passages are your documents. That is why this is two switches and not one:
# "do I want traces" and "may my documents leave this machine" are different
# decisions, and the person making the second is often not the one who made the
# first. With LANGSMITH_TRACING on and INCLUDE_TEXT off, the trace carries the
# question, the retrieval scores, the citation audit, and the cost - enough to
# tell a retriever failure from a generation failure - and no document text.
# Needs LANGSMITH_API_KEY and LANGSMITH_PROJECT in the environment.
LANGSMITH_TRACING=

# Set to 1 to include retrieved passage text and the model answer in traces.
# This uploads your document content to LangSmith.
LANGSMITH_TRACING_INCLUDE_TEXT=

# Same span tree written to a local JSONL file with no network call at all.
# Use this when the corpus cannot leave the host; testing a RAG system's
# observability should not require uploading the documents it is about.
# A bare name is written under data/; a path is used as-is.
LANGSMITH_TRACING_LOCAL=
